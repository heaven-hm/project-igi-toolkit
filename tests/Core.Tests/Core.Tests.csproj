<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IGIEditor.Core.Tests</AssemblyName>
    <RootNamespace>IGIEditor.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../IGIEditor/Core/*.cs" />
    <Compile Include="../../IGIEditor/QMissionTriggers.cs" />
    <None Include="../../IGIEditor/objects.qsc" Link="objects.qsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
